{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private RosoFood AI user account profile and personal daily nutrition goals.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "maxLength": 1000
        },
        "dailyGoals": {
          "type": "object",
          "description": "User daily calorie and macronutrient targets."
        },
        "dietProfile": {
          "type": "object",
          "description": "Optional body metrics (age, heightCm, weightKg, sex), activity level, fitness goal, dietary preference, and dailyBudgetInr for personalized diet coaching and meal planning."
        },
        "dailyWaterGoalMl": {
          "type": "number",
          "description": "Optional daily hydration goal in milliliters (500 to 10000 ml)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "dailyGoals", "createdAt", "updatedAt"]
    },
    "TrackedMeal": {
      "title": "TrackedMeal",
      "description": "A single analyzed meal or fruit entry logged privately to a user's food diary.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique meal entry identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the meal owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "description": "Local calendar date key in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "loggedAtIso": {
          "type": "string",
          "description": "ISO-8601 timestamp when the meal was logged.",
          "minLength": 10,
          "maxLength": 40
        },
        "mealCategory": {
          "type": "string",
          "enum": ["Breakfast", "Lunch", "Dinner", "Snack"],
          "description": "Meal category for daily tracking."
        },
        "imageThumbnailDataUrl": {
          "type": "string",
          "description": "Optional compact JPEG thumbnail data URL.",
          "maxLength": 80000
        },
        "analysis": {
          "type": "object",
          "description": "Structured Gemini Vision nutrition analysis payload."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "dateKey",
        "loggedAtIso",
        "mealCategory",
        "imageThumbnailDataUrl",
        "analysis",
        "createdAt",
        "updatedAt"
      ]
    },
    "MealPlan": {
      "title": "MealPlan",
      "description": "A personalized 5-meal Indian daily diet plan saved privately by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique saved meal plan identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the meal plan owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planName": {
          "type": "string",
          "description": "User-facing label for the saved meal plan.",
          "minLength": 1,
          "maxLength": 120
        },
        "input": {
          "type": "object",
          "description": "User parameters used to generate the plan."
        },
        "targetDailyCaloriesKcal": {
          "type": "number",
          "description": "Safe calculated daily calorie target (>= 1200 kcal)."
        },
        "estimatedBmrKcal": {
          "type": "number",
          "description": "Mifflin-St Jeor Basal Metabolic Rate estimate."
        },
        "estimatedTdeeKcal": {
          "type": "number",
          "description": "Estimated Total Daily Energy Expenditure."
        },
        "safetyNote": {
          "type": "string",
          "description": "Safety explanation and calorie pace guidance.",
          "maxLength": 500
        },
        "hydrationTip": {
          "type": "string",
          "description": "Daily hydration and meal timing tip.",
          "maxLength": 500
        },
        "budgetSummary": {
          "type": "string",
          "description": "Summary of how affordable Indian staples fit the daily food budget.",
          "maxLength": 500
        },
        "totals": {
          "type": "object",
          "description": "Estimated daily calories, protein, carbs, fat, and fiber totals."
        },
        "estimatedTotalCostInr": {
          "type": "number",
          "description": "Approximate total daily ingredient cost in INR."
        },
        "meals": {
          "type": "array",
          "description": "Exactly 5 planned Indian meals."
        },
        "estimationDisclaimer": {
          "type": "string",
          "description": "Explicit estimate & non-medical nutrition disclaimer.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "planName",
        "input",
        "targetDailyCaloriesKcal",
        "estimatedBmrKcal",
        "estimatedTdeeKcal",
        "safetyNote",
        "hydrationTip",
        "budgetSummary",
        "totals",
        "estimatedTotalCostInr",
        "meals",
        "estimationDisclaimer",
        "createdAt",
        "updatedAt"
      ]
    },
    "WaterLogEntry": {
      "title": "WaterLogEntry",
      "description": "A single water intake log entry recorded privately by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique water log entry identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the entry owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "description": "Local calendar date key in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "loggedAtIso": {
          "type": "string",
          "description": "ISO-8601 timestamp when the water intake was logged.",
          "minLength": 10,
          "maxLength": 40
        },
        "amountMl": {
          "type": "number",
          "description": "Water volume consumed in milliliters (10 to 5000 ml)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "dateKey",
        "loggedAtIso",
        "amountMl",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeeklyReport": {
      "title": "WeeklyReport",
      "description": "Saved 7-day nutrition and hydration summary report with AI insights scoped privately to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report identifier (e.g. week-YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the report owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "startDateKey": {
          "type": "string",
          "description": "7-day window start local date (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDateKey": {
          "type": "string",
          "description": "7-day window end local date (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "loggedMealDaysCount": {
          "type": "number",
          "description": "Number of days with >=1 logged meal in the 7-day window (0..7)."
        },
        "totalMealsLogged": {
          "type": "number",
          "description": "Total logged meal entries across the week."
        },
        "dailyAverageTotals": {
          "type": "object",
          "description": "Average estimated calories, protein, carbs, fat, and fiber per logged day."
        },
        "weeklyTotals": {
          "type": "object",
          "description": "Total estimated calories, protein, carbs, fat, and fiber across the week."
        },
        "dailyWaterGoalMl": {
          "type": "number",
          "description": "Snapshot of user daily hydration goal in ml."
        },
        "averageWaterMl": {
          "type": "number",
          "description": "Average water intake in ml across days with water logged (or 7-day window)."
        },
        "totalWaterMl": {
          "type": "number",
          "description": "Total logged water intake in ml for the week."
        },
        "dailyGoalsSnapshot": {
          "type": "object",
          "description": "Snapshot of user daily calorie & macro goals for that week."
        },
        "days": {
          "type": "array",
          "description": "Exactly 7 daily breakdown snapshots (calories, macros, mealCount, waterMl)."
        },
        "aiSummary": {
          "type": "string",
          "description": "Supportive non-medical AI weekly overview.",
          "maxLength": 1000
        },
        "highlights": {
          "type": "array",
          "description": "Up to 5 concise positive observations."
        },
        "suggestions": {
          "type": "array",
          "description": "Up to 5 practical, supportive suggestions."
        },
        "estimationDisclaimer": {
          "type": "string",
          "description": "Non-medical & estimated nutrition disclaimer.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "startDateKey",
        "endDateKey",
        "loggedMealDaysCount",
        "totalMealsLogged",
        "dailyAverageTotals",
        "weeklyTotals",
        "dailyWaterGoalMl",
        "averageWaterMl",
        "totalWaterMl",
        "dailyGoalsSnapshot",
        "days",
        "aiSummary",
        "highlights",
        "suggestions",
        "estimationDisclaimer",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, nutrition targets, and daily water goal for each authenticated user."
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": { "$ref": "#/entities/TrackedMeal" },
      "description": "Private daily food diary entries scoped strictly to the owning user."
    },
    "/users/{userId}/mealPlans/{planId}": {
      "schema": { "$ref": "#/entities/MealPlan" },
      "description": "Private personalized 5-meal Indian meal plans scoped strictly to the owning user."
    },
    "/users/{userId}/waterLogs/{entryId}": {
      "schema": { "$ref": "#/entities/WaterLogEntry" },
      "description": "Private daily water intake logs scoped strictly to the owning user."
    },
    "/users/{userId}/weeklyReports/{reportId}": {
      "schema": { "$ref": "#/entities/WeeklyReport" },
      "description": "Private AI weekly nutrition & hydration reports scoped strictly to the owning user."
    }
  }
}
