rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDailyGoals(goals) {
      return goals is map
        && goals.keys().hasAll(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && goals.keys().hasOnly(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && (goals.caloriesKcal is int || goals.caloriesKcal is float) && goals.caloriesKcal >= 400 && goals.caloriesKcal <= 15000
        && (goals.proteinGrams is int || goals.proteinGrams is float) && goals.proteinGrams >= 1 && goals.proteinGrams <= 1000
        && (goals.carbsGrams is int || goals.carbsGrams is float) && goals.carbsGrams >= 1 && goals.carbsGrams <= 2000
        && (goals.fatGrams is int || goals.fatGrams is float) && goals.fatGrams >= 1 && goals.fatGrams <= 1000
        && (goals.fiberGrams is int || goals.fiberGrams is float) && goals.fiberGrams >= 1 && goals.fiberGrams <= 500;
    }

    function isValidDietProfile(profile) {
      return profile is map
        && profile.keys().hasOnly(['age', 'heightCm', 'weightKg', 'sex', 'activityLevel', 'fitnessGoal', 'dietaryPreference', 'dailyBudgetInr'])
        && (!('age' in profile) || ((profile.age is int || profile.age is float) && profile.age >= 13 && profile.age <= 100))
        && (!('heightCm' in profile) || ((profile.heightCm is int || profile.heightCm is float) && profile.heightCm >= 100 && profile.heightCm <= 250))
        && (!('weightKg' in profile) || ((profile.weightKg is int || profile.weightKg is float) && profile.weightKg >= 25 && profile.weightKg <= 300))
        && (!('sex' in profile) || (profile.sex is string && profile.sex.size() <= 10 && profile.sex in ['male', 'female']))
        && (!('activityLevel' in profile) || (profile.activityLevel is string && profile.activityLevel.size() <= 20 && profile.activityLevel in ['sedentary', 'light', 'moderate', 'active']))
        && (!('fitnessGoal' in profile) || (profile.fitnessGoal is string && profile.fitnessGoal.size() <= 24 && profile.fitnessGoal in ['weight_loss', 'weight_gain', 'muscle_building', 'maintenance']))
        && (!('dietaryPreference' in profile) || (profile.dietaryPreference is string && profile.dietaryPreference.size() <= 24 && profile.dietaryPreference in ['vegetarian', 'non-vegetarian', 'eggetarian', 'vegan']))
        && (!('dailyBudgetInr' in profile) || ((profile.dailyBudgetInr is int || profile.dailyBudgetInr is float) && profile.dailyBudgetInr >= 50 && profile.dailyBudgetInr <= 5000));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'dailyGoals', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'dailyGoals', 'dietProfile', 'dailyWaterGoalMl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && isValidDailyGoals(data.dailyGoals)
        && (!('dietProfile' in data) || isValidDietProfile(data.dietProfile))
        && (!('dailyWaterGoalMl' in data) || ((data.dailyWaterGoalMl is int || data.dailyWaterGoalMl is float) && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMacroTotals(totals) {
      return totals is map
        && totals.keys().hasAll(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && totals.keys().hasOnly(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && (totals.caloriesKcal is int || totals.caloriesKcal is float) && totals.caloriesKcal >= 0 && totals.caloriesKcal <= 150000
        && (totals.proteinGrams is int || totals.proteinGrams is float) && totals.proteinGrams >= 0 && totals.proteinGrams <= 10000
        && (totals.carbsGrams is int || totals.carbsGrams is float) && totals.carbsGrams >= 0 && totals.carbsGrams <= 25000
        && (totals.fatGrams is int || totals.fatGrams is float) && totals.fatGrams >= 0 && totals.fatGrams <= 10000
        && (totals.fiberGrams is int || totals.fiberGrams is float) && totals.fiberGrams >= 0 && totals.fiberGrams <= 5000;
    }

    function isValidAnalysis(analysis) {
      return analysis is map
        && analysis.keys().hasAll([
          'identificationStatus',
          'confidence',
          'clarificationQuestion',
          'mealTitle',
          'estimatedServingSizeGrams',
          'servingDescription',
          'totals',
          'items',
          'dietSuggestions',
          'estimationDisclaimer'
        ])
        && analysis.keys().hasOnly([
          'identificationStatus',
          'confidence',
          'clarificationQuestion',
          'mealTitle',
          'estimatedServingSizeGrams',
          'servingDescription',
          'totals',
          'items',
          'dietSuggestions',
          'estimationDisclaimer'
        ])
        && analysis.identificationStatus in ['identified', 'needs_clarification', 'not_food']
        && analysis.confidence in ['high', 'medium', 'low']
        && analysis.clarificationQuestion is string && analysis.clarificationQuestion.size() <= 500
        && analysis.mealTitle is string && analysis.mealTitle.size() >= 1 && analysis.mealTitle.size() <= 200
        && (analysis.estimatedServingSizeGrams is int || analysis.estimatedServingSizeGrams is float)
        && analysis.estimatedServingSizeGrams >= 0 && analysis.estimatedServingSizeGrams <= 25000
        && analysis.servingDescription is string && analysis.servingDescription.size() <= 300
        && isValidMacroTotals(analysis.totals)
        && analysis.items is list && analysis.items.size() <= 30
        && (analysis.items.size() == 0 || analysis.items[0] is map)
        && analysis.dietSuggestions is map
        && analysis.estimationDisclaimer is string && analysis.estimationDisclaimer.size() <= 500;
    }

    function isValidTrackedMeal(data, userId, mealId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'mealCategory',
          'imageThumbnailDataUrl',
          'analysis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'mealCategory',
          'imageThumbnailDataUrl',
          'analysis',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == mealId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.loggedAtIso is string && data.loggedAtIso.size() >= 10 && data.loggedAtIso.size() <= 40
        && data.mealCategory in ['Breakfast', 'Lunch', 'Dinner', 'Snack']
        && data.imageThumbnailDataUrl is string && data.imageThumbnailDataUrl.size() <= 80000
        && isValidAnalysis(data.analysis)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealPlanInput(input) {
      return input is map
        && input.keys().hasAll([
          'age',
          'heightCm',
          'weightKg',
          'sex',
          'fitnessGoal',
          'activityLevel',
          'dietaryPreference',
          'dailyBudgetInr'
        ])
        && input.keys().hasOnly([
          'age',
          'heightCm',
          'weightKg',
          'sex',
          'fitnessGoal',
          'activityLevel',
          'dietaryPreference',
          'dailyBudgetInr'
        ])
        && (input.age is int || input.age is float) && input.age >= 13 && input.age <= 100
        && (input.heightCm is int || input.heightCm is float) && input.heightCm >= 100 && input.heightCm <= 250
        && (input.weightKg is int || input.weightKg is float) && input.weightKg >= 25 && input.weightKg <= 300
        && input.sex is string && input.sex.size() <= 10 && input.sex in ['male', 'female']
        && input.fitnessGoal is string && input.fitnessGoal.size() <= 24 && input.fitnessGoal in ['weight_loss', 'weight_gain', 'muscle_building', 'maintenance']
        && input.activityLevel is string && input.activityLevel.size() <= 20 && input.activityLevel in ['sedentary', 'light', 'moderate', 'active']
        && input.dietaryPreference is string && input.dietaryPreference.size() <= 24 && input.dietaryPreference in ['vegetarian', 'non-vegetarian', 'eggetarian', 'vegan']
        && (input.dailyBudgetInr is int || input.dailyBudgetInr is float) && input.dailyBudgetInr >= 50 && input.dailyBudgetInr <= 5000;
    }

    function isValidMealPlan(data, userId, planId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'planName',
          'input',
          'targetDailyCaloriesKcal',
          'estimatedBmrKcal',
          'estimatedTdeeKcal',
          'safetyNote',
          'hydrationTip',
          'budgetSummary',
          'totals',
          'estimatedTotalCostInr',
          'meals',
          'estimationDisclaimer',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'planName',
          'input',
          'targetDailyCaloriesKcal',
          'estimatedBmrKcal',
          'estimatedTdeeKcal',
          'safetyNote',
          'hydrationTip',
          'budgetSummary',
          'totals',
          'estimatedTotalCostInr',
          'meals',
          'estimationDisclaimer',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == planId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 120
        && isValidMealPlanInput(data.input)
        && (data.targetDailyCaloriesKcal is int || data.targetDailyCaloriesKcal is float) && data.targetDailyCaloriesKcal >= 1200 && data.targetDailyCaloriesKcal <= 6000
        && (data.estimatedBmrKcal is int || data.estimatedBmrKcal is float) && data.estimatedBmrKcal >= 800 && data.estimatedBmrKcal <= 4500
        && (data.estimatedTdeeKcal is int || data.estimatedTdeeKcal is float) && data.estimatedTdeeKcal >= 1000 && data.estimatedTdeeKcal <= 7000
        && data.safetyNote is string && data.safetyNote.size() <= 500
        && data.hydrationTip is string && data.hydrationTip.size() <= 500
        && data.budgetSummary is string && data.budgetSummary.size() <= 500
        && isValidMacroTotals(data.totals)
        && (data.estimatedTotalCostInr is int || data.estimatedTotalCostInr is float) && data.estimatedTotalCostInr >= 0 && data.estimatedTotalCostInr <= 10000
        && data.meals is list && data.meals.size() == 5
        && data.meals[0] is map
        && data.estimationDisclaimer is string && data.estimationDisclaimer.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWaterLog(data, userId, entryId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'amountMl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'amountMl',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.loggedAtIso is string && data.loggedAtIso.size() >= 10 && data.loggedAtIso.size() <= 40
        && (data.amountMl is int || data.amountMl is float) && data.amountMl >= 10 && data.amountMl <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWeeklyReport(data, userId, reportId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'startDateKey',
          'endDateKey',
          'loggedMealDaysCount',
          'totalMealsLogged',
          'dailyAverageTotals',
          'weeklyTotals',
          'dailyWaterGoalMl',
          'averageWaterMl',
          'totalWaterMl',
          'dailyGoalsSnapshot',
          'days',
          'aiSummary',
          'highlights',
          'suggestions',
          'estimationDisclaimer',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'startDateKey',
          'endDateKey',
          'loggedMealDaysCount',
          'totalMealsLogged',
          'dailyAverageTotals',
          'weeklyTotals',
          'dailyWaterGoalMl',
          'averageWaterMl',
          'totalWaterMl',
          'dailyGoalsSnapshot',
          'days',
          'aiSummary',
          'highlights',
          'suggestions',
          'estimationDisclaimer',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == reportId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.startDateKey is string && data.startDateKey.size() == 10 && data.startDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDateKey is string && data.endDateKey.size() == 10 && data.endDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.loggedMealDaysCount is int || data.loggedMealDaysCount is float) && data.loggedMealDaysCount >= 0 && data.loggedMealDaysCount <= 7
        && (data.totalMealsLogged is int || data.totalMealsLogged is float) && data.totalMealsLogged >= 0 && data.totalMealsLogged <= 500
        && isValidMacroTotals(data.dailyAverageTotals)
        && isValidMacroTotals(data.weeklyTotals)
        && (data.dailyWaterGoalMl is int || data.dailyWaterGoalMl is float) && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000
        && (data.averageWaterMl is int || data.averageWaterMl is float) && data.averageWaterMl >= 0 && data.averageWaterMl <= 20000
        && (data.totalWaterMl is int || data.totalWaterMl is float) && data.totalWaterMl >= 0 && data.totalWaterMl <= 140000
        && isValidDailyGoals(data.dailyGoalsSnapshot)
        && data.days is list && data.days.size() == 7
        && data.days[0] is map
        && data.aiSummary is string && data.aiSummary.size() >= 1 && data.aiSummary.size() <= 1000
        && data.highlights is list && data.highlights.size() <= 5
        && (data.highlights.size() == 0 || data.highlights[0] is string)
        && data.suggestions is list && data.suggestions.size() <= 5
        && (data.suggestions.size() == 0 || data.suggestions[0] is string)
        && data.estimationDisclaimer is string && data.estimationDisclaimer.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private User Profile & Goals (PII isolated per userId)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dailyGoals', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dietProfile', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dailyGoals', 'dietProfile', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dailyWaterGoalMl', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId) && isVerified();

      // Private Meal History subcollection
      match /meals/{mealId} {
        allow get: if isValidId(userId) && isValidId(mealId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isVerified()
          && isValidTrackedMeal(incoming(), userId, mealId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isVerified()
          && isValidTrackedMeal(incoming(), userId, mealId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mealCategory', 'analysis', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(mealId) && isOwner(userId) && isVerified();
      }

      // Private Personalized Indian Meal Plans subcollection
      match /mealPlans/{planId} {
        allow get: if isValidId(userId) && isValidId(planId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(planId)
          && isOwner(userId)
          && isVerified()
          && isValidMealPlan(incoming(), userId, planId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(planId)
          && isOwner(userId)
          && isVerified()
          && isValidMealPlan(incoming(), userId, planId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'planName',
            'input',
            'targetDailyCaloriesKcal',
            'estimatedBmrKcal',
            'estimatedTdeeKcal',
            'safetyNote',
            'hydrationTip',
            'budgetSummary',
            'totals',
            'estimatedTotalCostInr',
            'meals',
            'estimationDisclaimer',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(planId) && isOwner(userId) && isVerified();
      }

      // Private Daily Water Intake Logs subcollection
      match /waterLogs/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isVerified()
          && isValidWaterLog(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isVerified()
          && isValidWaterLog(incoming(), userId, entryId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['amountMl', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isVerified();
      }

      // Private AI Weekly Nutrition Reports subcollection
      match /weeklyReports/{reportId} {
        allow get: if isValidId(userId) && isValidId(reportId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(reportId)
          && isOwner(userId)
          && isVerified()
          && isValidWeeklyReport(incoming(), userId, reportId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(reportId)
          && isOwner(userId)
          && isVerified()
          && isValidWeeklyReport(incoming(), userId, reportId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'startDateKey',
            'endDateKey',
            'loggedMealDaysCount',
            'totalMealsLogged',
            'dailyAverageTotals',
            'weeklyTotals',
            'dailyWaterGoalMl',
            'averageWaterMl',
            'totalWaterMl',
            'dailyGoalsSnapshot',
            'days',
            'aiSummary',
            'highlights',
            'suggestions',
            'estimationDisclaimer',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(reportId) && isOwner(userId) && isVerified();
      }
    }
  }
}
