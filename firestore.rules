rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDailyGoals(goals) {
      return goals is map
        && goals.keys().hasAll(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && goals.keys().hasOnly(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && (goals.caloriesKcal is int || goals.caloriesKcal is float) && goals.caloriesKcal >= 400 && goals.caloriesKcal <= 15000
        && (goals.proteinGrams is int || goals.proteinGrams is float) && goals.proteinGrams >= 1 && goals.proteinGrams <= 1000
        && (goals.carbsGrams is int || goals.carbsGrams is float) && goals.carbsGrams >= 1 && goals.carbsGrams <= 2000
        && (goals.fatGrams is int || goals.fatGrams is float) && goals.fatGrams >= 1 && goals.fatGrams <= 1000
        && (goals.fiberGrams is int || goals.fiberGrams is float) && goals.fiberGrams >= 1 && goals.fiberGrams <= 500;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'dailyGoals', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'dailyGoals', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && isValidDailyGoals(data.dailyGoals)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMacroTotals(totals) {
      return totals is map
        && totals.keys().hasAll(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && totals.keys().hasOnly(['caloriesKcal', 'proteinGrams', 'carbsGrams', 'fatGrams', 'fiberGrams'])
        && (totals.caloriesKcal is int || totals.caloriesKcal is float) && totals.caloriesKcal >= 0 && totals.caloriesKcal <= 25000
        && (totals.proteinGrams is int || totals.proteinGrams is float) && totals.proteinGrams >= 0 && totals.proteinGrams <= 2000
        && (totals.carbsGrams is int || totals.carbsGrams is float) && totals.carbsGrams >= 0 && totals.carbsGrams <= 5000
        && (totals.fatGrams is int || totals.fatGrams is float) && totals.fatGrams >= 0 && totals.fatGrams <= 2000
        && (totals.fiberGrams is int || totals.fiberGrams is float) && totals.fiberGrams >= 0 && totals.fiberGrams <= 1000;
    }

    function isValidAnalysis(analysis) {
      return analysis is map
        && analysis.keys().hasAll([
          'identificationStatus',
          'confidence',
          'clarificationQuestion',
          'mealTitle',
          'estimatedServingSizeGrams',
          'servingDescription',
          'totals',
          'items',
          'dietSuggestions',
          'estimationDisclaimer'
        ])
        && analysis.keys().hasOnly([
          'identificationStatus',
          'confidence',
          'clarificationQuestion',
          'mealTitle',
          'estimatedServingSizeGrams',
          'servingDescription',
          'totals',
          'items',
          'dietSuggestions',
          'estimationDisclaimer'
        ])
        && analysis.identificationStatus in ['identified', 'needs_clarification', 'not_food']
        && analysis.confidence in ['high', 'medium', 'low']
        && analysis.clarificationQuestion is string && analysis.clarificationQuestion.size() <= 500
        && analysis.mealTitle is string && analysis.mealTitle.size() >= 1 && analysis.mealTitle.size() <= 200
        && (analysis.estimatedServingSizeGrams is int || analysis.estimatedServingSizeGrams is float)
        && analysis.estimatedServingSizeGrams >= 0 && analysis.estimatedServingSizeGrams <= 25000
        && analysis.servingDescription is string && analysis.servingDescription.size() <= 300
        && isValidMacroTotals(analysis.totals)
        && analysis.items is list && analysis.items.size() <= 30
        && (analysis.items.size() == 0 || analysis.items[0] is map)
        && analysis.dietSuggestions is map
        && analysis.estimationDisclaimer is string && analysis.estimationDisclaimer.size() <= 500;
    }

    function isValidTrackedMeal(data, userId, mealId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'mealCategory',
          'imageThumbnailDataUrl',
          'analysis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateKey',
          'loggedAtIso',
          'mealCategory',
          'imageThumbnailDataUrl',
          'analysis',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == mealId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.loggedAtIso is string && data.loggedAtIso.size() >= 10 && data.loggedAtIso.size() <= 40
        && data.mealCategory in ['Breakfast', 'Lunch', 'Dinner', 'Snack']
        && data.imageThumbnailDataUrl is string && data.imageThumbnailDataUrl.size() <= 80000
        && isValidAnalysis(data.analysis)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private User Profile & Goals (PII isolated per userId)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['dailyGoals', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId) && isVerified();

      // Private Meal History subcollection
      match /meals/{mealId} {
        allow get: if isValidId(userId) && isValidId(mealId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isVerified()
          && isValidTrackedMeal(incoming(), userId, mealId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isVerified()
          && isValidTrackedMeal(incoming(), userId, mealId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mealCategory', 'analysis', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(mealId) && isOwner(userId) && isVerified();
      }
    }
  }
}
